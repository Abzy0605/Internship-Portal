<%@ page import="java.sql.*" %>
<%@ page import="java.util.*" %>
<%@ page import="com.internship.DBConnector" %>
<%@ page import="com.internship.CsrfToken" %>
<%!
private String escapeHtml(String value) { return value == null ? "" : value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;"); }
%>
<%
if (!"admin".equals(session.getAttribute("role"))) { response.sendRedirect("login.jsp"); return; }
String csrfToken = CsrfToken.getOrCreate(session);
List<Map<String, String>> students = new ArrayList<Map<String, String>>();
List<Map<String, String>> staffMembers = new ArrayList<Map<String, String>>();
boolean databaseError = false;
try (Connection con = DBConnector.getConnection();
     PreparedStatement staffStatement = con.prepareStatement("SELECT staff_id, name FROM staff ORDER BY name, staff_id");
     ResultSet staffResults = staffStatement.executeQuery()) {
    while (staffResults.next()) { Map<String, String> member = new HashMap<String, String>(); member.put("staff_id", staffResults.getString("staff_id")); member.put("name", staffResults.getString("name")); staffMembers.add(member); }
    try (PreparedStatement studentStatement = con.prepareStatement("SELECT st.student_id, st.name, st.department, st.email, st.mentor_id, m.name AS mentor_name FROM student st LEFT JOIN staff m ON st.mentor_id=m.staff_id ORDER BY st.student_id"); ResultSet studentResults = studentStatement.executeQuery()) {
        while (studentResults.next()) { Map<String, String> student = new HashMap<String, String>(); String[] columns = {"student_id", "name", "department", "email", "mentor_id", "mentor_name"}; for (String column : columns) student.put(column, studentResults.getString(column)); students.add(student); }
    }
} catch (Exception e) { databaseError = true; }
String assignment = request.getParameter("assignment");
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Student Assignments | EEC Internship Portal</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>body{background:#f5f7fb;font-family:'Segoe UI',sans-serif}.sidebar{position:fixed;top:0;left:0;width:260px;height:100vh;background:#6b1d1d;color:#fff;padding:25px}.logo-section{text-align:center;margin-bottom:35px}.logo-section img{width:70px;height:70px;object-fit:contain;background:#fff;border-radius:12px;padding:5px}.college-title{margin-top:15px;font-size:18px;font-weight:700}.portal-text{font-size:13px;opacity:.85}.sidebar-menu{margin-top:30px}.sidebar-menu a{display:block;padding:14px 18px;color:#fff;text-decoration:none;border-radius:10px;margin-bottom:10px}.sidebar-menu a:hover,.active-link{background:rgba(255,255,255,.15)}.sidebar-menu i{margin-right:10px}.main-content{margin-left:260px;padding:30px}.topbar,.assignment-card{background:#fff;border-radius:18px;padding:25px;box-shadow:0 3px 15px rgba(0,0,0,.08)}.topbar{display:flex;justify-content:space-between;align-items:center}.page-title{font-size:28px;font-weight:700;margin:0}.admin-badge{background:#6b1d1d;color:#fff;padding:8px 14px;border-radius:20px;font-size:13px}.assignment-card{margin-top:22px}.assignment-card:last-child{margin-bottom:22px}@media(max-width:768px){.sidebar{position:relative;width:100%;height:auto}.main-content{margin-left:0;padding:20px}}</style></head>
<body><aside class="sidebar"><div class="logo-section"><img src="images/EEC_logo.png" alt="EEC Logo"><div class="college-title">EEC</div><div class="portal-text">Internship Management System</div></div><nav class="sidebar-menu"><a href="admin_dashboard.jsp"><i class="bi bi-speedometer2"></i>Dashboard</a><a href="manage_students.jsp"><i class="bi bi-people-fill"></i>Students</a><a class="active-link" href="manage_student_assignments.jsp"><i class="bi bi-person-check-fill"></i>Student Assignments</a><a href="manage_staff.jsp"><i class="bi bi-person-workspace"></i>Staff</a><a href="admin_internship_records.jsp"><i class="bi bi-folder-check"></i>Internship Records</a><form action="LogoutServlet" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button type="submit" class="btn btn-link text-white p-0"><i class="bi bi-box-arrow-right"></i>Logout</button></form></nav></aside>
<main class="main-content"><div class="topbar"><div><h1 class="page-title">Student Assignments</h1><div class="text-muted">Assign each student to one faculty mentor, or leave them unassigned.</div></div><div class="admin-badge">Administrator</div></div>
<% if (databaseError) { %><div class="alert alert-danger mt-4">Unable to load assignment data.</div><% } %>
<% if ("success".equals(assignment)) { %><div class="alert alert-success mt-4">Student assignment updated successfully.</div><% } else if (assignment != null) { %><div class="alert alert-danger mt-4">Unable to update the student assignment.</div><% } %>
<% if (students.isEmpty() && !databaseError) { %><div class="assignment-card text-center text-muted"><i class="bi bi-inbox fs-3"></i><div class="mt-2">No students available.</div></div><% } %>
<% for (Map<String, String> student : students) { %><section class="assignment-card"><div class="row align-items-end g-3"><div class="col-md-4"><strong><%= escapeHtml(student.get("name")) %></strong><div class="text-muted"><%= escapeHtml(student.get("student_id")) %></div><small class="text-muted"><%= escapeHtml(student.get("department")) %> · <%= escapeHtml(student.get("email")) %></small></div><div class="col-md-3"><div class="text-muted small">Current Mentor</div><strong><%= student.get("mentor_id") == null ? "Unassigned" : escapeHtml(student.get("mentor_name")) + " (" + escapeHtml(student.get("mentor_id")) + ")" %></strong></div><form class="col-md-5 row g-2" action="ManageStudentAssignmentsServlet" method="post"><input type="hidden" name="csrfToken" value="<%= escapeHtml(csrfToken) %>"><input type="hidden" name="student_id" value="<%= escapeHtml(student.get("student_id")) %>"><div class="col-sm-8"><label class="form-label">Assigned Staff</label><select class="form-select" name="mentor_id"><option value="">Unassigned</option><% for (Map<String, String> member : staffMembers) { %><option value="<%= escapeHtml(member.get("staff_id")) %>" <%= member.get("staff_id").equals(student.get("mentor_id")) ? "selected" : "" %>><%= escapeHtml(member.get("name")) %> (<%= escapeHtml(member.get("staff_id")) %>)</option><% } %></select></div><div class="col-sm-4 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Save Assignment</button></div></form></div></section><% } %>
</main></body></html>
