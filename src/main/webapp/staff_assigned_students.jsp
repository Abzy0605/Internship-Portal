<%@ page import="java.sql.*" %>
<%@ page import="com.internship.DBConnector" %>
<%@ page import="com.internship.CsrfToken" %>
<%!
private String escapeHtml(String value) { return value == null ? "" : value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;"); }
%>
<%
if (!"staff".equals(session.getAttribute("role"))) { response.sendRedirect("login.jsp"); return; }
String staffId = (String) session.getAttribute("staff_id");
if (staffId == null || staffId.trim().isEmpty()) { response.sendRedirect("login.jsp"); return; }
boolean databaseError = false;
String csrfToken = CsrfToken.getOrCreate(session);
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Assigned Students | EEC Internship Portal</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>body{background:#f5f7fb;font-family:'Segoe UI',sans-serif}.sidebar{position:fixed;top:0;left:0;width:260px;height:100vh;background:#6b1d1d;color:#fff;padding:25px}.logo-section{text-align:center;margin-bottom:35px}.logo-section img{width:70px;height:70px;object-fit:contain;background:#fff;border-radius:12px;padding:5px}.college-title{margin-top:15px;font-size:18px;font-weight:700}.portal-text{font-size:13px;opacity:.85}.sidebar-menu{margin-top:30px}.sidebar-menu a{display:block;padding:14px 18px;color:#fff;text-decoration:none;border-radius:10px;margin-bottom:10px}.sidebar-menu a:hover,.active-link{background:rgba(255,255,255,.15)}.sidebar-menu i{margin-right:10px}.main-content{margin-left:260px;padding:30px}.topbar,.content-card{background:#fff;border-radius:18px;padding:25px;box-shadow:0 3px 15px rgba(0,0,0,.08)}.topbar{display:flex;justify-content:space-between;align-items:center}.page-title{font-size:28px;font-weight:700;margin:0}.staff-badge{background:#6b1d1d;color:#fff;padding:8px 14px;border-radius:20px;font-size:13px}.content-card{margin-top:22px}.student-table thead th{background:#6b1d1d;color:#fff;border:0;padding:14px}.student-table td{vertical-align:middle;padding:14px}.empty-state{padding:35px;text-align:center;color:#777}@media(max-width:768px){.sidebar{position:relative;width:100%;height:auto}.main-content{margin-left:0;padding:20px}}</style></head>
<body><aside class="sidebar"><div class="logo-section"><img src="images/EEC_logo.png" alt="EEC Logo"><div class="college-title">EEC</div><div class="portal-text">Internship Management System</div></div><nav class="sidebar-menu"><a href="staff_dashboard.jsp"><i class="bi bi-speedometer2"></i>Dashboard</a><a href="staff_internship_reviews.jsp"><i class="bi bi-file-earmark-check"></i>Internship Reviews</a><a class="active-link" href="staff_assigned_students.jsp"><i class="bi bi-people-fill"></i>Assigned Students</a><a href="staff_reports.jsp"><i class="bi bi-bar-chart-line-fill"></i>Reports</a><form action="LogoutServlet" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button type="submit" class="btn btn-link text-white p-0"><i class="bi bi-box-arrow-right"></i>Logout</button></form></nav></aside>
<main class="main-content"><div class="topbar"><div><h1 class="page-title">Assigned Students</h1><div class="text-muted">Students currently assigned to you.</div></div><div class="staff-badge">Faculty Mentor</div></div><section class="content-card"><% try (Connection con = DBConnector.getConnection(); PreparedStatement ps = con.prepareStatement("SELECT student_id, name, department, email FROM student WHERE mentor_id=? ORDER BY student_id")) { ps.setString(1, staffId); try (ResultSet rs = ps.executeQuery()) { boolean hasStudents = false; %><div class="table-responsive"><table class="table student-table"><thead><tr><th>Student ID</th><th>Name</th><th>Department</th><th>Email</th></tr></thead><tbody><% while (rs.next()) { hasStudents = true; %><tr><td><strong><%= escapeHtml(rs.getString("student_id")) %></strong></td><td><%= escapeHtml(rs.getString("name")) %></td><td><%= escapeHtml(rs.getString("department")) %></td><td><%= escapeHtml(rs.getString("email")) %></td></tr><% } %></tbody></table></div><% if (!hasStudents) { %><div class="empty-state"><i class="bi bi-people fs-2"></i><div class="mt-2">No students assigned.</div></div><% } } } catch (Exception e) { databaseError = true; } %><% if (databaseError) { %><div class="alert alert-danger">Unable to load assigned students.</div><% } %></section></main></body></html>
